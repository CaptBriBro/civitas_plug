{
  "name": "civitas-browser-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Estensione browser Civitas: scarica le attività, acquisisce gli articoli da Normattiva e prepara le analisi con ChatGPT o Gemini.",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.0.287",
    "@wxt-dev/module-svelte": "^2.0.2",
    "happy-dom": "^15.11.7",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wxt": "^0.19.29"
  },
  "dependencies": {
    "lucide-svelte": "^0.475.0"
  }
}
